      "id": "483a2d67-79bf-44cc-ac1d-b104364eff01",
      "name": "Fictional Video Metrics",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "jsCode": "const video = $input.first().json;\nconst views = Number(video.views);\nconst velocity = views / Math.max(1, Number(video.publishedHoursAgo));\nconst outlier = views / Math.max(100, Number(video.channelSubscribers));\nconst engagement = views ? ((Number(video.likes) + Number(video.comments)) / views) * 100 : 0;\nreturn [{ json: {\n  title: video.title,\n  viewVelocity: Number(velocity.toFixed(2)),\n  outlierScore: Number(outlier.toFixed(4)),\n  engagementRate: Number(engagement.toFixed(2)),\n  opportunityBand: outlier >= 1.5 ? 'high' : outlier >= 0.75 ? 'medium' : 'baseline'\n} }];"
      },
      "id": "8eb567e1-c56c-4f43-9b9c-b344d2ce66d4",
      "name": "Score Opportunity",
      "type": "n8n-nodes-base.code",
